{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.0",
  "defaultTools": ["+codemode"],
  "enabledModels": [
    "openai/gpt-6.1-sol:medium",
    "pi-claude-cli/claude-opus-5-5:high",
    "openai-codex/gpt-6.1-sol:medium",
    "openai-codex/gpt-6-astra:medium",
    "google/gemini-3.8-flash:medium",
    "deepseek/deepseek-flash:max"
  ],
  "packages": [
    "git:github.com/earendil-works/pi-review",
    "npm:pi-ask-user",
    "npm:@ff-labs/pi-fff",
    {
      "source": "https://github.com/mitsuhiko/agent-stuff",
      "extensions": [
        "extensions/unified-edit.ts",
        "extensions/session-breakdown.ts",
        "extensions/whimsical.ts"
      ],
      "skills": ["skills/github", "skills/commit"],
      "prompts": [],
      "themes": ["themes/nightowl.json", "themes/dayowl.json", "themes/modern-dark.json"]
    },
    "npm:pi-intercom",
    "npm:@plannotator/pi-extension",
    "npm:pi-subagents",
    "npm:webfox",
    "git:github.com/dmmulroy/pi-claude-cli"
  ],
  "hideThinkingBlock": false,
  "defaultThinkingLevel": "medium",
  "theme": "catppuccin-macchiato",
  "editorPaddingX": 1,
  "treeFilterMode": "all",
  "doubleEscapeAction": "tree",
  "showHardwareCursor": false,
  "npmCommand": ["mise", "exec", "node", "--", "npm"],
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "showCacheMissNotices": true,
  "subagents": {
    "disableBuiltins": true
  },
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "deviceId": "9719c93c-babd-44aa-aaba-ecd22029d52c",
  "extensionChangelogVersions": {
    "{\"source\":\"https://github.com/mitsuhiko/agent-stuff\",\"scope\":\"user\"}": "1.6.0",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.84.0"
  }
}
