{
  "lastChangelogVersion": "0.83.0",
  "enabledModels": [
    "google/gemini-3.6-flash",
    "openai-codex/gpt-5.6-sol",
    "cursor/glm-5.2",
    "cursor/opus-4.8@1m",
    "deepseek/deepseek-v4-flash",
    "deepseek/deepseek-v4-pro",
    "cursor/gpt-5.6-sol@272k",
    "cursor/grok-4.5",
    "cursor/composer-2.5"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "packages": [
    "npm:pi-mcp-adapter",
    "git:github.com/earendil-works/pi-review",
    "npm:pi-ask-user",
    "npm:@ff-labs/pi-fff",
    {
      "source": "https://github.com/mitsuhiko/agent-stuff",
      "extensions": [
        "extensions/control.ts",
        "extensions/unified-edit.ts",
        "extensions/notify.ts",
        "extensions/session-breakdown.ts",
        "extensions/uv.ts",
        "extensions/whimsical.ts",
        "extensions/btw.ts"
      ],
      "skills": [
        "skills/github",
        "skills/librarian",
        "skills/summarize"
      ],
      "prompts": [],
      "themes": [
        "themes/nightowl.json",
        "themes/dayowl.json",
        "themes/modern-dark.json"
      ]
    },
    "https://github.com/nicobailon/pi-subagents",
    "npm:pi-intercom",
    "npm:pi-prompt-template-model",
    "npm:pi-cursor-sdk",
    "npm:@plannotator/pi-extension",
    "npm:pi-web-providers"
  ],
  "hideThinkingBlock": false,
  "defaultThinkingLevel": "medium",
  "theme": "catppuccin-macchiato",
  "editorPaddingX": 1,
  "treeFilterMode": "all",
  "doubleEscapeAction": "tree",
  "showHardwareCursor": false,
  "npmCommand": [
    "mise",
    "exec",
    "node",
    "--",
    "npm"
  ],
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "showCacheMissNotices": true,
  "subagents": {
    "disableBuiltins": true,
    "agentOverrides": {
      "delegate": {
        "disabled": false
      }
    }
  }
